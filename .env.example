# 本地默认是 http://localhost:4321/；GitHub Actions 会自动读取 Pages 正式网址。
# 如需本地检查正式域名或项目子路径，填入完整网址后重新构建。
SITE_URL=http://localhost:4321/

# 可选：你的 GitHub 用户名，用于导航和个人资料链接。不是密码或访问令牌。
# GitHub Actions 会自动使用仓库所有者的用户名。
PUBLIC_GITHUB_USERNAME=

# 线上写作后台的 Cloudflare Worker 地址，仅填 HTTPS origin，不加末尾斜杠。
# 这是公开地址；Client Secret 只通过 wrangler secret put 保存。
# GitHub Actions 对应仓库变量 CMS_AUTH_URL。
PUBLIC_CMS_AUTH_URL=
